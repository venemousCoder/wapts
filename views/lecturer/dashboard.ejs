<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Lecturer Dashboard</h2>
    <p class="text-muted mb-0">My Courses & Assessments</p>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card card-hover h-100 border-0 shadow-sm border-start border-primary border-4">
      <div class="card-body">
        <h6 class="text-muted text-uppercase fw-bold mb-3">Active Courses</h6>
        <div class="d-flex align-items-center">
          <div class="fs-2 fw-bold text-dark me-3"><%= activeCourses %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-hover h-100 border-0 shadow-sm border-start border-success border-4">
      <div class="card-body">
        <h6 class="text-muted text-uppercase fw-bold mb-3">Total Students</h6>
        <div class="d-flex align-items-center">
          <div class="fs-2 fw-bold text-dark me-3"><%= totalStudents %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-hover h-100 border-0 shadow-sm border-start border-warning border-4">
      <div class="card-body">
        <h6 class="text-muted text-uppercase fw-bold mb-3">Assessments</h6>
        <div class="d-flex align-items-center">
          <div class="fs-2 fw-bold text-warning me-3"><%= pendingAssessments %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
    <h5 class="fw-bold mb-0">My Course Offerings</h5>
  </div>
  <div class="card-body">
    <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th class="text-muted fw-bold">Course Code</th>
            <th class="text-muted fw-bold">Title</th>
            <th class="text-muted fw-bold">Semester</th>
            <th class="text-muted fw-bold">Capacity</th>
            <th class="text-muted fw-bold">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (assignedOfferings && assignedOfferings.length > 0) { %>
            <% assignedOfferings.forEach(offering => { %>
              <tr>
                <td><strong><%= offering.courseId.code %></strong></td>
                <td><%= offering.courseId.title %></td>
                <td><%= offering.semesterId ? offering.semesterId.name : 'N/A' %></td>
                <td><%= offering.capacity %></td>
                <td>
                  <a href="/lecturer/courses" class="btn btn-outline-primary btn-sm fw-bold me-2"><i class="fas fa-cog"></i> Manage</a>
                  <a href="/lecturer/assessments?courseOfferingId=<%= offering._id %>" class="btn btn-primary btn-sm fw-bold"><i class="fas fa-upload"></i> Upload Scores</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">No course offerings assigned.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
