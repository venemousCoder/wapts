<div class="row align-items-center mb-4">
  <div class="col-md-8">
    <h2 class="fw-bold mb-1 text-dark">Lecturer Dashboard</h2>
    <p class="text-muted mb-0">Welcome back, <%= user.firstName %>.</p>
  </div>
  <div class="col-md-4 text-md-end mt-3 mt-md-0">
    <a href="/lecturer/attendance" class="btn btn-primary shadow-sm">
      <i class="fas fa-clipboard-list me-2"></i> Take Attendance
    </a>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-primary border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Active Courses</h6>
            <h3 class="fw-bold text-dark mb-0"><%= activeCourses %></h3>
          </div>
          <div class="icon-circle bg-primary bg-opacity-10 text-primary">
            <i class="fas fa-book-open"></i>
          </div>
        </div>
        <div class="mt-3 text-primary small fw-medium">
          <i class="fas fa-calendar me-1"></i> Current Semester
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-success border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Total Students</h6>
            <h3 class="fw-bold text-dark mb-0"><%= totalStudents %></h3>
          </div>
          <div class="icon-circle bg-success bg-opacity-10 text-success">
            <i class="fas fa-users"></i>
          </div>
        </div>
        <div class="mt-3 text-success small fw-medium">
          <i class="fas fa-user-graduate me-1"></i> Across all courses
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-warning border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Pending Assessments</h6>
            <h3 class="fw-bold text-warning mb-0"><%= pendingAssessments %></h3>
          </div>
          <div class="icon-circle bg-warning bg-opacity-10 text-warning">
            <i class="fas fa-tasks"></i>
          </div>
        </div>
        <div class="mt-3 text-warning small fw-medium">
          <i class="fas fa-clock me-1"></i> Drafts to publish
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-bottom-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold text-dark"><i class="fas fa-chalkboard-teacher me-2 text-primary"></i> My Course Offerings</h5>
        <a href="/lecturer/courses" class="btn btn-sm btn-light text-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Course</th>
                <th>Semester</th>
                <th>Capacity</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody class="border-top-0">
              <% if (assignedOfferings && assignedOfferings.length > 0) { %>
                <% assignedOfferings.forEach(offering => { %>
                  <tr>
                    <td class="ps-4 py-3">
                      <div class="d-flex align-items-center">
                        <div class="icon-circle bg-light text-primary me-3 fw-bold" style="width: 40px; height: 40px; font-size: 0.9rem;">
                          <%= offering.courseId.code %>
                        </div>
                        <div>
                          <h6 class="mb-0 fw-bold text-dark"><%= offering.courseId.title %></h6>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-2">
                        <i class="far fa-calendar-alt me-1"></i> <%= offering.semesterId ? offering.semesterId.name : 'N/A' %>
                      </span>
                    </td>
                    <td>
                      <div class="d-flex align-items-center">
                        <i class="fas fa-user-friends text-muted me-2"></i>
                        <span class="fw-medium text-dark"><%= offering.capacity %></span>
                      </div>
                    </td>
                    <td class="text-end pe-4">
                      <a href="/lecturer/courses" class="btn btn-sm btn-light text-primary rounded-circle shadow-sm me-1" data-bs-toggle="tooltip" title="Manage Course">
                        <i class="fas fa-cog"></i>
                      </a>
                      <a href="/lecturer/assessments?courseOfferingId=<%= offering._id %>" class="btn btn-sm btn-primary rounded-circle shadow-sm" data-bs-toggle="tooltip" title="Upload Scores">
                        <i class="fas fa-upload"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="text-center py-5">
                    <div class="empty-state p-0">
                      <i class="fas fa-book-open text-muted opacity-50 mb-3" style="font-size: 2.5rem;"></i>
                      <h6 class="fw-bold">No Courses Assigned</h6>
                      <p class="small mb-0">You have not been assigned to teach any courses this semester.</p>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
