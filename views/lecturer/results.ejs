<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="fw-bold mb-1">Final Results Compilation</h2>
      <p class="text-muted">Review computed results and submit them to the HOD for approval.</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i> Result submitted successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="row mb-4">
    <div class="col-md-8">
      <form action="/lecturer/results" method="GET" class="card border-0 shadow-sm p-4">
        <label for="courseOfferingId" class="form-label fw-bold">Select Course</label>
        <div class="d-flex">
          <select name="courseOfferingId" id="courseOfferingId" class="form-select me-2" required>
            <option value="" disabled <%= !selectedOffering ? 'selected' : '' %>>Choose a course...</option>
            <% assignedOfferings.forEach(offering => { %>
              <option value="<%= offering._id %>" <%= selectedOffering && selectedOffering._id.toString() === offering._id.toString() ? 'selected' : '' %>>
                <%= offering.courseId.code %> - <%= offering.courseId.title %> (<%= offering.semesterId.name %>)
              </option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-primary px-4">Load</button>
        </div>
      </form>
    </div>
  </div>

  <% if (selectedOffering) { %>
    <div class="row g-4 mb-4">
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
            <div>
              <h5 class="fw-bold text-primary mb-0"><i class="fas fa-list-ol me-2"></i> Compiled Results</h5>
              <p class="text-muted small mb-0"><%= enrolledStudents.length %> students enrolled</p>
            </div>
            <div class="d-flex gap-2">
              <form action="/lecturer/results/compile" method="POST" class="m-0">
                <input type="hidden" name="courseOfferingId" value="<%= selectedOffering._id %>">
                <button type="submit" class="btn btn-warning shadow-sm fw-bold px-4 rounded-pill" onclick="this.disabled=true; this.innerHTML='Compiling...'; this.form.submit();">
                  <i class="fas fa-cogs me-2"></i> Compile Results
                </button>
              </form>
              <% const draftResults = results.filter(r => r.status === 'Draft'); %>
              <% if (draftResults.length > 0) { %>
                <form action="/lecturer/results/submit-all" method="POST" class="m-0">
                  <input type="hidden" name="courseOfferingId" value="<%= selectedOffering._id %>">
                  <button type="submit" class="btn btn-success shadow-sm fw-bold px-4 rounded-pill" onclick="return confirm('Are you sure you want to submit all <%= draftResults.length %> draft results to the HOD? They cannot be edited after submission.')">
                    <i class="fas fa-upload me-2"></i> Submit All (<%= draftResults.length %>)
                  </button>
                </form>
              <% } %>
            </div>
          </div>
          <div class="card-body">
            <% if (results.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Student</th>
                      <th>Identifier</th>
                      <th>Total Score</th>
                      <th>Grade</th>
                      <th>Status</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% results.forEach(result => { %>
                      <tr>
                        <td class="fw-medium"><%= result.enrollmentId.studentId.userId.firstName %> <%= result.enrollmentId.studentId.userId.lastName %></td>
                        <td><span class="text-muted"><%= result.enrollmentId.studentId.userId.loginIdentifier %></span></td>
                        <td><%= result.finalScore !== undefined ? result.finalScore : '-' %></td>
                        <td class="fw-bold text-<%= result.isPass ? 'success' : 'danger' %>"><%= result.letterGrade || '-' %></td>
                        <td>
                          <% let badgeClass = 'secondary';
                             if (result.status === 'Draft') badgeClass = 'warning';
                             if (result.status === 'Submitted') badgeClass = 'info';
                             if (result.status === 'Approved') badgeClass = 'primary';
                             if (result.status === 'Published') badgeClass = 'success';
                          %>
                          <span class="badge bg-<%= badgeClass %> bg-opacity-10 text-<%= badgeClass %> px-2 py-1"><%= result.status %></span>
                        </td>
                        <td>
                          <% if (result.status === 'Draft') { %>
                            <button type="button" class="btn btn-sm btn-outline-success px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#submitModal<%= result._id %>">
                              Submit to HOD
                            </button>
                            
                            <!-- Submit Modal -->
                            <div class="modal fade" id="submitModal<%= result._id %>" tabindex="-1" aria-hidden="true">
                              <div class="modal-dialog">
                                <div class="modal-content">
                                  <form action="/lecturer/results/submit" method="POST">
                                    <input type="hidden" name="resultId" value="<%= result._id %>">
                                    <div class="modal-header border-0 pb-0">
                                      <h5 class="modal-title fw-bold">Submit Result</h5>
                                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                      <p>Are you sure you want to submit the result for <strong><%= result.enrollmentId.studentId.userId.firstName %> <%= result.enrollmentId.studentId.userId.lastName %></strong>?</p>
                                      <p class="text-danger small mb-0"><i class="fas fa-exclamation-triangle me-1"></i> You will not be able to modify this result once submitted.</p>
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                      <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                      <button type="submit" class="btn btn-success px-4" onclick="this.disabled=true; this.innerHTML='Submitting...'; this.form.submit();">Confirm Submit</button>
                                    </div>
                                  </form>
                                </div>
                              </div>
                            </div>
                          <% } else { %>
                            <button class="btn btn-sm btn-light px-3 rounded-pill disabled">Submitted</button>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5 text-muted">
                <i class="fas fa-file-invoice fa-3x mb-3 text-light"></i>
                <p>No compiled results available for this course.</p>
                <small>Ensure all assessments are graded and the system has computed the final scores.</small>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>
