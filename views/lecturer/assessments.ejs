<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="fw-bold mb-1">Assessments & Scoring</h2>
      <p class="text-muted">Manage course assessments and record student scores.</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i> Action completed successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="row mb-4">
    <div class="col-md-8">
      <form action="/lecturer/assessments" method="GET" class="card border-0 shadow-sm p-4">
        <label for="courseOfferingId" class="form-label fw-bold">Select Course</label>
        <div class="d-flex">
          <select name="courseOfferingId" id="courseOfferingId" class="form-select me-2" required>
            <option value="" disabled <%= !selectedOffering ? 'selected' : '' %>>Choose a course...</option>
            <% assignedOfferings.forEach(offering => { %>
              <option value="<%= offering._id %>" <%= selectedOffering && selectedOffering._id.toString() === offering._id.toString() ? 'selected' : '' %>>
                <%= offering.courseId.code %> - <%= offering.courseId.title %> (<%= offering.semesterId.name %>)
              </option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-primary px-4">Load</button>
        </div>
      </form>
    </div>
  </div>

  <% if (selectedOffering) { %>
    <div class="row g-4 mb-4">
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-primary mb-0"><i class="fas fa-tasks me-2"></i> Course Assessments</h5>
            <button class="btn btn-sm btn-primary px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#createAssessmentModal">
              <i class="fas fa-plus me-1"></i> New Assessment
            </button>
          </div>
          <div class="card-body">
            <% if (assessments.length > 0) { %>
              <form action="/lecturer/assessments/bulk-action" method="POST" id="bulkAssessmentForm">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="selectAllAssessments">
                    <label class="form-check-label fw-bold" for="selectAllAssessments">Select All Drafts</label>
                  </div>
                  <div>
                    <button type="submit" name="action" value="publish" class="btn btn-sm btn-outline-success px-3 rounded-pill">
                      <i class="fas fa-bullhorn me-1"></i> Publish Selected
                    </button>
                  </div>
                </div>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                      <tr>
                        <th width="40"></th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Weight (%)</th>
                        <th>Max Marks</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% assessments.forEach(assessment => { %>
                        <tr>
                          <td>
                            <% if (assessment.status === 'Draft') { %>
                              <div class="form-check">
                                <input class="form-check-input assessment-checkbox" type="checkbox" name="assessmentIds[]" value="<%= assessment._id %>">
                              </div>
                            <% } %>
                          </td>
                          <td class="fw-bold"><%= assessment.title %></td>
                          <td class="fw-medium"><%= assessment.assessmentTypeId.name %></td>
                          <td><%= assessment.weight %>%</td>
                          <td><%= assessment.maximumMarks %></td>
                          <td><%= assessment.dueDate ? new Date(assessment.dueDate).toLocaleDateString() : 'N/A' %></td>
                          <td>
                            <% if (assessment.status === 'Draft') { %>
                              <span class="badge bg-secondary">Draft</span>
                            <% } else { %>
                              <span class="badge bg-success">Published</span>
                            <% } %>
                          </td>
                          <td>
                            <% if (assessment.status === 'Draft') { %>
                              <button type="button" class="btn btn-sm btn-success rounded-pill px-3" onclick="submitSingleAssessmentAction('<%= assessment._id %>', 'publish')">Publish</button>
                            <% } else { %>
                              <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#scoreModal<%= assessment._id %>">
                                Enter Scores
                              </button>
                            <% } %>
                          </td>
                        </tr>

                        <!-- Score Entry Modal -->
                        <div class="modal fade" id="scoreModal<%= assessment._id %>" tabindex="-1" aria-labelledby="scoreModalLabel<%= assessment._id %>" aria-hidden="true">
                          <div class="modal-dialog modal-lg modal-dialog-scrollable">
                            <form action="/lecturer/assessments/scores" method="POST" id="scoreForm<%= assessment._id %>">
                              <input type="hidden" name="assessmentId" value="<%= assessment._id %>">
                              <input type="hidden" name="courseOfferingId" value="<%= selectedOffering._id %>">
                              <div class="modal-content">
                                <div class="modal-header">
                                  <h5 class="modal-title fw-bold" id="scoreModalLabel<%= assessment._id %>">Enter Scores: <%= assessment.assessmentTypeId.name %></h5>
                                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                  <div class="alert alert-info py-2">
                                    Maximum Marks: <strong><%= assessment.maximumMarks %></strong>
                                  </div>
                                  <% if (enrolledStudents.length > 0) { %>
                                    <table class="table table-sm align-middle">
                                      <thead>
                                        <tr>
                                          <th>Student</th>
                                          <th>Identifier</th>
                                          <th style="width: 150px;">Score</th>
                                        </tr>
                                      </thead>
                                      <tbody>
                                        <% enrolledStudents.forEach((student, index) => { 
                                            const existingScore = studentAssessments.find(sa => sa.studentId.toString() === student._id.toString() && sa.assessmentId.toString() === assessment._id.toString());
                                        %>
                                          <tr>
                                            <td><%= student.userId.firstName %> <%= student.userId.lastName %></td>
                                            <td><span class="text-muted"><%= student.userId.loginIdentifier %></span></td>
                                            <td>
                                              <input type="hidden" name="scoresData[<%= index %>][studentId]" value="<%= student._id %>">
                                              <input type="number" name="scoresData[<%= index %>][score]" class="form-control form-control-sm" min="0" max="<%= assessment.maximumMarks %>" value="<%= existingScore ? existingScore.score : '' %>" step="0.1" required>
                                            </td>
                                          </tr>
                                        <% }) %>
                                      </tbody>
                                    </table>
                                  <% } else { %>
                                    <p class="text-muted text-center py-3">No students enrolled.</p>
                                  <% } %>
                                </div>
                                <div class="modal-footer">
                                  <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                  <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Saving...'; this.form.submit();">Save Scores</button>
                                </div>
                              </div>
                            </form>
                          </div>
                        </div>

                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </form>
            <% } else { %>
              <div class="text-center py-5 text-muted">
                <i class="fas fa-clipboard-list fa-3x mb-3 text-light"></i>
                <p>No assessments have been created for this course yet.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Create Assessment Modal -->
    <div class="modal fade" id="createAssessmentModal" tabindex="-1" aria-labelledby="createAssessmentModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-scrollable">
        <form action="/lecturer/assessments" method="POST" id="createAssessmentForm">
          <input type="hidden" name="courseOfferingId" value="<%= selectedOffering._id %>">
          <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
              <h5 class="modal-title fw-bold" id="createAssessmentModalLabel">New Assessment</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <% const currentWeight = assessments.reduce((sum, a) => sum + a.weight, 0); %>
              <% const remainingWeight = 100 - currentWeight; %>
              <div class="mb-3">
                <label for="title" class="form-label small fw-bold">Assessment Title</label>
                <input type="text" name="title" id="title" class="form-control" placeholder="e.g. Quiz 1" required maxlength="100">
              </div>
              <div class="mb-3">
                <label for="assessmentTypeId" class="form-label small fw-bold">Assessment Type</label>
                <select name="assessmentTypeId" id="assessmentTypeId" class="form-select" required>
                  <option value="" disabled selected>Select Type...</option>
                  <% assessmentTypes.forEach(type => { %>
                    <option value="<%= type._id %>"><%= type.name %> (Default Weight: <%= type.defaultWeight %>%)</option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label for="maximumMarks" class="form-label small fw-bold">Maximum Marks</label>
                <input type="number" name="maximumMarks" id="maximumMarks" class="form-control" required min="1">
              </div>
              <div class="mb-3">
                <label for="weight" class="form-label small fw-bold">Assessment Weight (%)</label>
                <input type="number" name="weight" id="weight" class="form-control" required min="1" max="<%= remainingWeight %>" oninput="document.getElementById('weightError').style.display = this.value > <%= remainingWeight %> ? 'block' : 'none'">
                <div class="form-text mt-2">
                  <span class="d-block">Current Total Weight: <strong><%= currentWeight %>%</strong></span>
                  <span class="d-block">Remaining Weight: <strong><%= remainingWeight %>%</strong></span>
                </div>
                <div id="weightError" class="invalid-feedback fw-bold text-danger mt-1">Cannot create assessment. Total assessment weight would exceed 100%.</div>
              </div>
              <div class="mb-3">
                <label for="dueDate" class="form-label small fw-bold">Due Date (Optional)</label>
                <input type="date" name="dueDate" id="dueDate" class="form-control" min="<%= new Date().toISOString().split('T')[0] %>">
              </div>
              <div class="mb-3">
                <label for="description" class="form-label small fw-bold">Description (Optional)</label>
                <textarea name="description" id="description" class="form-control" rows="3" placeholder="Assessment instructions..."></textarea>
              </div>
              <div class="mb-3">
                <label for="status" class="form-label small fw-bold">Status</label>
                <select name="status" id="status" class="form-select" required>
                  <option value="Draft" selected>Draft</option>
                  <option value="Published">Published</option>
                </select>
              </div>
            </div>
            <div class="modal-footer border-0 pt-0">
              <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary px-4" id="submitAssessmentBtn" onclick="if(document.getElementById('weight').value <= <%= remainingWeight %>){this.disabled=true; this.innerHTML='Creating...'; this.form.submit();}">Create Assessment</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  <% } %>
</div>

<form id="singleActionForm" action="/lecturer/assessments/bulk-action" method="POST" class="d-none">
  <input type="hidden" name="action" id="singleActionType">
  <input type="hidden" name="assessmentIds[]" id="singleActionAssessmentId">
</form>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selectAll = document.getElementById('selectAllAssessments');
    const checkboxes = document.querySelectorAll('.assessment-checkbox');
    
    if (selectAll) {
      selectAll.addEventListener('change', function() {
        checkboxes.forEach(cb => cb.checked = selectAll.checked);
      });
    }
    
    checkboxes.forEach(cb => {
      cb.addEventListener('change', function() {
        if (!this.checked) selectAll.checked = false;
        else if (document.querySelectorAll('.assessment-checkbox:checked').length === checkboxes.length) {
          selectAll.checked = true;
        }
      });
    });
  });

  function submitSingleAssessmentAction(assessmentId, action) {
    document.getElementById('singleActionType').value = action;
    document.getElementById('singleActionAssessmentId').value = assessmentId;
    document.getElementById('singleActionForm').submit();
  }
</script>
