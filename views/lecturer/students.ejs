<div class="row mb-4">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <div>
      <h2 class="fw-bold mb-1">Student Management</h2>
      <p class="text-muted">Manage students in your assigned levels.</p>
    </div>
    <div>
      <button class="btn btn-outline-info px-4 rounded-pill shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#cohortRegistrationModal">
        <i class="fas fa-layer-group me-2"></i> Cohort Registration
      </button>
      <button class="btn btn-outline-primary px-4 rounded-pill shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#importStudentsModal">
        <i class="fas fa-file-import me-2"></i> Bulk Import
      </button>
      <button class="btn btn-primary px-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#createStudentModal">
        <i class="fas fa-user-plus me-2"></i> Add Student
      </button>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="fas fa-check-circle me-2"></i> <%= success === 'true' ? 'Action completed successfully.' : success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof tempPassword !== 'undefined' && tempPassword) { %>
  <div class="alert alert-info alert-dismissible fade show fw-bold" role="alert">
    <i class="fas fa-key me-2"></i> <%= tempPassword %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof importSummary !== 'undefined' && importSummary) { %>
  <div class="alert alert-<%= importSummary.failed > 0 ? 'warning' : 'success' %> alert-dismissible fade show" role="alert">
    <div class="d-flex align-items-center mb-2">
      <i class="fas fa-info-circle fs-4 me-3"></i>
      <div>
        <h6 class="alert-heading fw-bold mb-1">Import Summary</h6>
        <p class="mb-0">Processed: <%= importSummary.total %> | Successful: <%= importSummary.successful %> | Failed: <%= importSummary.failed %></p>
      </div>
    </div>
    <% if (importSummary.errors && importSummary.errors.length > 0) { %>
      <hr>
      <p class="mb-2 fw-bold">Errors encountered:</p>
      <ul class="mb-0 small" style="max-height: 150px; overflow-y: auto;">
        <% importSummary.errors.forEach(function(err) { %>
          <li><%= err %></li>
        <% }); %>
      </ul>
    <% } %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Reg Number</th>
            <th>Name</th>
            <th>Programme</th>
            <th>Level</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (students && students.length > 0) { %>
            <% students.forEach(student => { %>
              <tr>
                <td class="fw-medium">
                  <%= student.loginIdentifier %>
                  <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-1" data-bs-toggle="modal" data-bs-target="#editRegModal<%= student._id %>" title="Edit Reg Number">
                    <i class="fas fa-edit"></i>
                  </button>
                </td>
                <td><%= student.firstName %> <%= student.lastName %></td>
                <td><%= student.profile ? student.profile.programme : 'N/A' %></td>
                <td><%= student.profile ? student.profile.level : 'N/A' %> Level</td>
                <td>
                  <span class="badge bg-<%= student.isDeleted ? 'danger' : 'success' %> bg-opacity-10 text-<%= student.isDeleted ? 'danger' : 'success' %> px-2 py-1">
                    <%= student.isDeleted ? 'Inactive' : 'Active' %>
                  </span>
                </td>
                <td>
                  <form action="/lecturer/students/<%= student._id %>/toggle-status" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-light <%= student.isDeleted ? 'text-success' : 'text-danger' %>" title="<%= student.isDeleted ? 'Activate' : 'Deactivate' %>">
                      <i class="fas <%= student.isDeleted ? 'fa-check' : 'fa-ban' %>"></i>
                    </button>
                  </form>
                  <a href="/lecturer/students/<%= student._id %>/registration" class="btn btn-sm btn-light text-primary ms-1" title="Manage Registration">
                    <i class="fas fa-book-open"></i>
                  </a>
                </td>
              </tr>

              <!-- Edit Reg Number Modal -->
              <div class="modal fade" id="editRegModal<%= student._id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-sm">
                  <form action="/lecturer/students/<%= student._id %>/edit-reg-number" method="POST">
                    <div class="modal-content border-0 shadow">
                      <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-bold">Edit Reg Number</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <p class="small text-muted mb-2">Student: <%= student.firstName %> <%= student.lastName %></p>
                        <div class="mb-2">
                          <label class="form-label small fw-bold">New Registration Number</label>
                          <input type="text" name="newRegNumber" class="form-control" value="<%= student.loginIdentifier %>" required>
                        </div>
                      </div>
                      <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary px-3">Save</button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">No students found in your assigned levels.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Create Student Modal -->
<div class="modal fade" id="createStudentModal" tabindex="-1" aria-labelledby="createStudentModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/lecturer/students" method="POST">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="createStudentModalLabel">Register New Student</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label small fw-bold">Registration Number *</label>
              <input type="text" name="loginIdentifier" class="form-control" required placeholder="e.g. 2023/12345">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label small fw-bold">Email Address *</label>
              <input type="email" name="email" class="form-control" required placeholder="student@example.com">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label small fw-bold">First Name *</label>
              <input type="text" name="firstName" class="form-control" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label small fw-bold">Last Name *</label>
              <input type="text" name="lastName" class="form-control" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label small fw-bold">Phone Number</label>
              <input type="text" name="phoneNumber" class="form-control" placeholder="Optional">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label small fw-bold">Gender</label>
              <select name="gender" class="form-select">
                <option value="">Select Gender (Optional)</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Date of Birth</label>
            <input type="date" name="dateOfBirth" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Programme *</label>
            <input type="text" name="programme" class="form-control" required placeholder="e.g. BSc Computer Science">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Level</label>
            <select name="level" class="form-select" required>
              <% if (typeof assignedLevels !== 'undefined' && assignedLevels.length > 0) { %>
                <% assignedLevels.forEach(lvl => { %>
                  <option value="<%= lvl %>"><%= lvl %> Level</option>
                <% }) %>
              <% } else { %>
                <option value="" disabled>No assigned levels</option>
              <% } %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Admission Year</label>
            <input type="text" name="admissionYear" class="form-control" required placeholder="e.g. 2023/2024">
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Registering...'; this.form.submit();">Register Student</button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Bulk Import Modal -->
<div class="modal fade" id="importStudentsModal" tabindex="-1" aria-labelledby="importStudentsModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/lecturer/students/import" method="POST" enctype="multipart/form-data">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="importStudentsModalLabel">Bulk Import Students</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Upload CSV File</label>
            <input type="file" name="importFile" class="form-control" accept=".csv" required>
            <div class="form-text mt-2">
              Ensure your CSV contains the following columns exactly:<br>
              <code>firstName, lastName, Registration Number, Email Address, Programme, Level, Admission Session</code>
            </div>
            <div class="alert alert-info mt-3 small py-2">
              <i class="fas fa-info-circle me-1"></i> <strong>Note:</strong> The default temporary password for all imported students will be their <strong>Last Name (lowercase) followed by '123'</strong> (e.g. <code>smith123</code>). They will be forced to change it upon first login.
            </div>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Importing...'; this.form.submit();">Import Data</button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Cohort Registration Modal -->
<div class="modal fade" id="cohortRegistrationModal" tabindex="-1" aria-labelledby="cohortRegistrationModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/lecturer/students/cohort-registration" method="POST">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="cohortRegistrationModalLabel">Cohort Course Registration</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted">Apply the recommended registration to all students in a specific level. This will register them for all published departmental courses corresponding to their level.</p>
          <div class="mb-3">
            <label class="form-label small fw-bold">Select Cohort Level</label>
            <select name="level" class="form-select" required>
              <% if (typeof assignedLevels !== 'undefined' && assignedLevels.length > 0) { %>
                <% assignedLevels.forEach(lvl => { %>
                  <option value="<%= lvl %>"><%= lvl %> Level</option>
                <% }) %>
              <% } else { %>
                <option value="" disabled>No assigned levels</option>
              <% } %>
            </select>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info text-white px-4" onclick="this.disabled=true; this.innerHTML='Registering Cohort...'; this.form.submit();">Apply Registration</button>
        </div>
      </div>
    </form>
  </div>
</div>
