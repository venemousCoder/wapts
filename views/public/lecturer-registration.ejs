<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lecturer Onboarding - WAPTS</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-white border-0 text-center pt-5 pb-3">
            <h3 class="fw-bold text-primary mb-1"><i class="fas fa-chalkboard-teacher me-2"></i>Lecturer Onboarding</h3>
            <p class="text-muted small">Submit your request for access to the portal.</p>
          </div>
          <div class="card-body px-5 pb-5">
            <% if (typeof success !== 'undefined' && success) { %>
              <div class="alert alert-success d-flex align-items-center" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                <div><%= success %></div>
              </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                <div><%= error %></div>
              </div>
            <% } %>

            <% if (!success) { %>
            <form action="/onboarding/lecturer" method="POST">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label small fw-bold">First Name <span class="text-danger">*</span></label>
                  <input type="text" name="firstName" class="form-control bg-light" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold">Last Name <span class="text-danger">*</span></label>
                  <input type="text" name="lastName" class="form-control bg-light" required>
                </div>

                <div class="col-md-12">
                  <label class="form-label small fw-bold">Institution Email Address <span class="text-danger">*</span></label>
                  <input type="email" name="email" class="form-control bg-light" placeholder="e.g. name@university.edu.ng" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label small fw-bold">Staff Number <span class="text-danger">*</span></label>
                  <input type="text" name="staffNumber" class="form-control bg-light" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label small fw-bold">Department <span class="text-danger">*</span></label>
                  <select name="departmentId" class="form-select bg-light" required>
                    <option value="" disabled selected>Select Department...</option>
                    <% if (typeof departments !== 'undefined' && departments) { %>
                      <% departments.forEach(dept => { %>
                        <option value="<%= dept._id %>"><%= dept.name %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>

                <div class="col-md-12 mt-4 pt-3 border-top">
                  <h6 class="fw-bold mb-3 text-secondary">Additional Information (Optional)</h6>
                </div>

                <div class="col-md-6">
                  <label class="form-label small fw-bold">Phone Number</label>
                  <input type="text" name="phone" class="form-control bg-light">
                </div>

                <div class="col-md-6">
                  <label class="form-label small fw-bold">Academic Rank / Designation</label>
                  <select name="academicRank" class="form-select bg-light">
                    <option value="">Select Rank...</option>
                    <option value="Graduate Assistant">Graduate Assistant</option>
                    <option value="Assistant Lecturer">Assistant Lecturer</option>
                    <option value="Lecturer II">Lecturer II</option>
                    <option value="Lecturer I">Lecturer I</option>
                    <option value="Senior Lecturer">Senior Lecturer</option>
                    <option value="Reader">Reader</option>
                    <option value="Professor">Professor</option>
                  </select>
                </div>

                <div class="col-md-12">
                  <label class="form-label small fw-bold">Office Location</label>
                  <input type="text" name="officeLocation" class="form-control bg-light" placeholder="e.g. Room 304, Block B">
                </div>
              </div>

              <div class="mt-4 pt-2">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" onclick="this.innerHTML='<span class=\'spinner-border spinner-border-sm me-2\' role=\'status\' aria-hidden=\'true\'></span>Submitting...'; this.disabled=true; this.form.submit();">
                  Submit Request <i class="fas fa-arrow-right ms-2"></i>
                </button>
              </div>
            </form>
            <% } %>

            <div class="text-center mt-4">
              <a href="/auth/login" class="text-decoration-none text-muted small"><i class="fas fa-arrow-left me-1"></i> Return to Login</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
