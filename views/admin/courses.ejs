<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <div>
        <h2 class="fw-bold mb-1">Courses</h2>
        <p class="text-muted">Manage academic courses.</p>
      </div>
      <button class="btn btn-primary px-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#createCourseModal">
        <i class="fas fa-plus me-2"></i> Add Course
      </button>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i> Action completed successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <form action="/admin/courses/bulk-action" method="POST" id="bulkCourseForm">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="selectAllCourses">
            <label class="form-check-label fw-bold" for="selectAllCourses">Select All</label>
          </div>
          <div>
            <button type="submit" name="action" value="restore" class="btn btn-sm btn-outline-success px-3 rounded-pill me-2">
              <i class="fas fa-undo me-1"></i> Restore Selected
            </button>
            <button type="submit" name="action" value="delete" class="btn btn-sm btn-outline-danger px-3 rounded-pill">
              <i class="fas fa-trash me-1"></i> Delete Selected
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th width="40"></th>
                <th>Course Code</th>
                <th>Title</th>
                <th>Credit Units</th>
                <th>Department</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (courses && courses.length > 0) { %>
                <% courses.forEach(course => { %>
                  <tr>
                    <td>
                      <div class="form-check">
                        <input class="form-check-input course-checkbox" type="checkbox" name="courseIds[]" value="<%= course._id %>">
                      </div>
                    </td>
                    <td class="fw-bold text-primary"><%= course.code %></td>
                    <td><%= course.title %></td>
                    <td><%= course.creditUnits %></td>
                    <td><span class="text-muted small"><%= course.departmentId ? course.departmentId.name : 'Unknown' %></span></td>
                    <td>
                      <span class="badge bg-<%= course.isDeleted ? 'danger' : 'success' %> bg-opacity-10 text-<%= course.isDeleted ? 'danger' : 'success' %> px-2 py-1">
                        <%= course.isDeleted ? 'Inactive' : 'Active' %>
                      </span>
                    </td>
                    <td>
                      <button type="button" class="btn btn-sm btn-light text-primary me-1" data-bs-toggle="modal" data-bs-target="#editCourseModal<%= course._id %>" title="Edit Course">
                        <i class="fas fa-edit"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-light <%= course.isDeleted ? 'text-success' : 'text-danger' %>" onclick="submitSingleCourseAction('<%= course._id %>', '<%= course.isDeleted ? 'restore' : 'delete' %>')" title="<%= course.isDeleted ? 'Restore' : 'Delete' %>">
                        <i class="fas <%= course.isDeleted ? 'fa-undo' : 'fa-trash' %>"></i>
                      </button>
                    </td>
                  </tr>

                <!-- Edit Course Modal -->
                <div class="modal fade" id="editCourseModal<%= course._id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog">
                    <form action="/admin/courses/<%= course._id %>/edit" method="POST">
                      <div class="modal-content border-0 shadow">
                        <div class="modal-header border-0 pb-0">
                          <h5 class="modal-title fw-bold">Edit Course</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Course Code</label>
                            <input type="text" name="code" class="form-control" required value="<%= course.code %>">
                          </div>
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Course Title</label>
                            <input type="text" name="title" class="form-control" required value="<%= course.title %>">
                          </div>
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Credit Units</label>
                            <input type="number" name="creditUnits" class="form-control" required min="1" max="10" value="<%= course.creditUnits %>">
                          </div>
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Department</label>
                            <select name="departmentId" class="form-select" required>
                              <option value="" disabled>Select Department...</option>
                              <% if (typeof departments !== 'undefined' && departments) { %>
                                <% departments.forEach(dept => { %>
                                  <option value="<%= dept._id %>" <%= course.departmentId && course.departmentId._id.toString() === dept._id.toString() ? 'selected' : '' %>><%= dept.name %> (<%= dept.code %>)</option>
                                <% }) %>
                              <% } %>
                            </select>
                          </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Saving...'; this.form.submit();">Save Changes</button>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">No courses found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      </form>
    </div>
  </div>
</div>

<form id="singleActionForm" action="/admin/courses/bulk-action" method="POST" class="d-none">
  <input type="hidden" name="action" id="singleActionType">
  <input type="hidden" name="courseIds[]" id="singleActionCourseId">
</form>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selectAll = document.getElementById('selectAllCourses');
    const checkboxes = document.querySelectorAll('.course-checkbox');
    
    if (selectAll) {
      selectAll.addEventListener('change', function() {
        checkboxes.forEach(cb => cb.checked = selectAll.checked);
      });
    }
    
    checkboxes.forEach(cb => {
      cb.addEventListener('change', function() {
        if (!this.checked) selectAll.checked = false;
        else if (document.querySelectorAll('.course-checkbox:checked').length === checkboxes.length) {
          selectAll.checked = true;
        }
      });
    });
  });

  function submitSingleCourseAction(courseId, action) {
    document.getElementById('singleActionType').value = action;
    document.getElementById('singleActionCourseId').value = courseId;
    document.getElementById('singleActionForm').submit();
  }
</script>

<!-- Create Course Modal -->
<div class="modal fade" id="createCourseModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/admin/courses" method="POST">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">New Course</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Course Code</label>
            <input type="text" name="code" class="form-control" required placeholder="e.g. CSC101">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Course Title</label>
            <input type="text" name="title" class="form-control" required placeholder="e.g. Introduction to Computer Science">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Credit Units</label>
            <input type="number" name="creditUnits" class="form-control" required min="1" max="10" placeholder="e.g. 3">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Department</label>
            <select name="departmentId" class="form-select" required>
              <option value="" disabled selected>Select Department...</option>
              <% if (typeof departments !== 'undefined' && departments) { %>
                <% departments.forEach(dept => { %>
                  <option value="<%= dept._id %>"><%= dept.name %> (<%= dept.code %>)</option>
                <% }) %>
              <% } %>
            </select>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Creating...'; this.form.submit();">Create</button>
        </div>
      </div>
    </form>
  </div>
</div>
