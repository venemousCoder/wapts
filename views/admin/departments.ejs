<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <div>
        <h2 class="fw-bold mb-1">Departments</h2>
        <p class="text-muted">Manage academic departments.</p>
      </div>
      <button class="btn btn-primary px-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#createDeptModal">
        <i class="fas fa-plus me-2"></i> Add Department
      </button>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i> Action completed successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Code</th>
              <th>Name</th>
              <th>Status</th>
              <th>Created Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (departments && departments.length > 0) { %>
              <% departments.forEach(dept => { %>
                <tr>
                  <td class="fw-bold text-primary"><%= dept.code %></td>
                  <td><%= dept.name %></td>
                  <td>
                    <span class="badge bg-<%= dept.isDeleted ? 'danger' : 'success' %> bg-opacity-10 text-<%= dept.isDeleted ? 'danger' : 'success' %> px-2 py-1">
                      <%= dept.isDeleted ? 'Inactive' : 'Active' %>
                    </span>
                  </td>
                  <td><span class="text-muted small"><%= new Date(dept.createdAt).toLocaleDateString() %></span></td>
                  <td>
                    <button type="button" class="btn btn-sm btn-light text-primary me-1" data-bs-toggle="modal" data-bs-target="#editDeptModal<%= dept._id %>" title="Edit Department">
                      <i class="fas fa-edit"></i>
                    </button>
                    <form action="/admin/departments/<%= dept._id %>/toggle-status" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-light <%= dept.isDeleted ? 'text-success' : 'text-danger' %>" title="<%= dept.isDeleted ? 'Restore' : 'Delete' %>">
                        <i class="fas <%= dept.isDeleted ? 'fa-undo' : 'fa-trash' %>"></i>
                      </button>
                    </form>
                  </td>
                </tr>

                <!-- Edit Department Modal -->
                <div class="modal fade" id="editDeptModal<%= dept._id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog">
                    <form action="/admin/departments/<%= dept._id %>/edit" method="POST">
                      <div class="modal-content border-0 shadow">
                        <div class="modal-header border-0 pb-0">
                          <h5 class="modal-title fw-bold">Edit Department</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Department Code</label>
                            <input type="text" name="code" class="form-control" required value="<%= dept.code %>">
                          </div>
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Department Name</label>
                            <input type="text" name="name" class="form-control" required value="<%= dept.name %>">
                          </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Saving...'; this.form.submit();">Save Changes</button>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">No departments found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Create Department Modal -->
<div class="modal fade" id="createDeptModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/admin/departments" method="POST">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">New Department</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Department Code</label>
            <input type="text" name="code" class="form-control" required placeholder="e.g. CSC">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Department Name</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. Computer Science">
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Creating...'; this.form.submit();">Create</button>
        </div>
      </div>
    </form>
  </div>
</div>
