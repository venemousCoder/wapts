<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <div>
        <h2 class="fw-bold mb-1">Academic Calendar</h2>
        <p class="text-muted">Manage academic sessions and semesters.</p>
      </div>
      <button class="btn btn-primary px-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#createSessionModal">
        <i class="fas fa-calendar-plus me-2"></i> New Session
      </button>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i> Action completed successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold text-primary mb-0"><i class="fas fa-calendar-alt me-2"></i> Academic Sessions</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Session Name</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (sessions && sessions.length > 0) { %>
                  <% sessions.forEach(session => { %>
                    <tr>
                      <td class="fw-medium"><%= session.name %></td>
                      <td>
                        <% let statusClass = 'secondary';
                           if(session.status === 'Active') statusClass = 'success';
                           if(session.status === 'Upcoming') statusClass = 'info';
                           if(session.status === 'Closed') statusClass = 'warning';
                           if(session.status === 'Archived') statusClass = 'secondary';
                        %>
                        <span class="badge bg-<%= statusClass %> bg-opacity-10 text-<%= statusClass %> px-2 py-1"><%= session.status %></span>
                      </td>
                      <td>
                        <button class="btn btn-sm btn-light text-primary me-1" data-bs-toggle="modal" data-bs-target="#editSessionModal<%= session._id %>"><i class="fas fa-edit"></i></button>
                      </td>
                    </tr>
<!-- Edit Session Modal -->
<div class="modal fade" id="editSessionModal<%= session._id %>" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/admin/sessions/<%= session._id %>/edit" method="POST">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">Edit Academic Session</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-start">
          <div class="mb-3">
            <label class="form-label small fw-bold">Session Name</label>
            <input type="text" name="name" class="form-control" required value="<%= session.name %>">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Status</label>
            <select name="status" class="form-select" required>
              <option value="Upcoming" <%= session.status === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
              <option value="Active" <%= session.status === 'Active' ? 'selected' : '' %>>Active</option>
              <option value="Closed" <%= session.status === 'Closed' ? 'selected' : '' %>>Closed</option>
              <option value="Archived" <%= session.status === 'Archived' ? 'selected' : '' %>>Archived</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Saving...'; this.form.submit();">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</div>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="3" class="text-center py-4 text-muted">No sessions found.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold text-primary mb-0"><i class="fas fa-calendar-week me-2"></i> Semesters</h5>
          <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createSemesterModal">
            <i class="fas fa-plus me-1"></i> Add
          </button>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Session</th>
                  <th>Semester Name</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (semesters && semesters.length > 0) { %>
                  <% semesters.forEach(semester => { %>
                    <tr>
                      <td><span class="text-muted small"><%= semester.sessionId ? semester.sessionId.name : 'Unknown' %></span></td>
                      <td class="fw-medium"><%= semester.name %></td>
                      <td>
                        <span class="badge bg-<%= semester.isActive ? 'success' : 'secondary' %> bg-opacity-10 text-<%= semester.isActive ? 'success' : 'secondary' %> px-2 py-1">
                          <%= semester.isActive ? 'Active' : 'Inactive' %>
                        </span>
                      </td>
                      <td>
                        <button class="btn btn-sm btn-light text-primary me-1" data-bs-toggle="modal" data-bs-target="#editSemesterModal<%= semester._id %>"><i class="fas fa-edit"></i></button>
                      </td>
                    </tr>
<!-- Edit Semester Modal -->
<div class="modal fade" id="editSemesterModal<%= semester._id %>" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/admin/semesters/<%= semester._id %>/edit" method="POST">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">Edit Semester</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-start">
          <div class="mb-3">
            <label class="form-label small fw-bold">Academic Session</label>
            <select name="sessionId" class="form-select" required>
              <option value="" disabled>Select Session...</option>
              <% if (sessions) { sessions.forEach(s => { %>
                <option value="<%= s._id %>" <%= semester.sessionId && semester.sessionId._id.toString() === s._id.toString() ? 'selected' : '' %>><%= s.name %></option>
              <% }) } %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Semester Name</label>
            <input type="text" name="name" class="form-control" required value="<%= semester.name %>">
          </div>
          <div class="mb-3">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="isActive" id="isActive<%= semester._id %>" value="true" <%= semester.isActive ? 'checked' : '' %>>
              <label class="form-check-label" for="isActive<%= semester._id %>">Set as Active</label>
            </div>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Saving...'; this.form.submit();">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</div>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="text-center py-4 text-muted">No semesters found.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Session Modal -->
<div class="modal fade" id="createSessionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/admin/sessions" method="POST">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">New Academic Session</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Session Name</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. 2023/2024">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Status</label>
            <select name="status" class="form-select" required>
              <option value="Upcoming">Upcoming</option>
              <option value="Active">Active</option>
              <option value="Closed">Closed</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Creating...'; this.form.submit();">Create</button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Create Semester Modal -->
<div class="modal fade" id="createSemesterModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/admin/semesters" method="POST">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">New Semester</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Academic Session</label>
            <select name="sessionId" class="form-select" required>
              <option value="" disabled selected>Select Session...</option>
              <% if (sessions) { sessions.forEach(session => { %>
                <option value="<%= session._id %>"><%= session.name %></option>
              <% }) } %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Semester Name</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. First Semester">
          </div>
          <div class="mb-3">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="isActive" id="isActive" value="true" checked>
              <label class="form-check-label" for="isActive">Set as Active</label>
            </div>
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4" onclick="this.disabled=true; this.innerHTML='Creating...'; this.form.submit();">Create</button>
        </div>
      </div>
    </form>
  </div>
</div>
