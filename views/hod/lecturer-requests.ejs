<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <div>
        <h2 class="fw-bold mb-1">Lecturer Requests</h2>
        <p class="text-muted">Review and manage pending onboarding requests for your department.</p>
      </div>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <form action="/hod/lecturer-requests/bulk-action" method="POST" id="bulkRequestForm" class="p-3">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="selectAllRequests">
            <label class="form-check-label fw-bold" for="selectAllRequests">Select All</label>
          </div>
          <div>
            <button type="submit" name="action" value="approve" class="btn btn-sm btn-outline-success px-3 rounded-pill me-2">
              <i class="fas fa-check me-1"></i> Approve Selected
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#bulkRejectModal">
              <i class="fas fa-times me-1"></i> Reject Selected
            </button>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th width="40"></th>
                <th>Name</th>
                <th>Institution Email</th>
                <th>Staff Number</th>
                <th>Date Submitted</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (requests && requests.length > 0) { %>
                <% requests.forEach(request => { %>
                  <tr>
                    <td>
                      <% if (request.status === 'Pending') { %>
                        <div class="form-check">
                          <input class="form-check-input request-checkbox" type="checkbox" name="requestIds[]" value="<%= request._id %>">
                        </div>
                      <% } %>
                    </td>
                    <td class="fw-medium"><%= request.firstName %> <%= request.lastName %></td>
                    <td><%= request.email %></td>
                    <td><%= request.staffNumber %></td>
                    <td><%= request.createdAt.toLocaleDateString() %></td>
                    <td>
                      <% let badgeClass = 'warning';
                         if(request.status === 'Approved') badgeClass = 'success';
                         if(request.status === 'Rejected') badgeClass = 'danger';
                      %>
                      <span class="badge bg-<%= badgeClass %> bg-opacity-10 text-<%= badgeClass %> px-2 py-1"><%= request.status %></span>
                    </td>
                    <td>
                      <button type="button" class="btn btn-sm btn-light text-primary me-1" data-bs-toggle="modal" data-bs-target="#viewRequestModal<%= request._id %>" title="View Details">
                        <i class="fas fa-eye"></i> View
                      </button>
                      <% if (request.status === 'Pending') { %>
                        <button type="button" class="btn btn-sm btn-success text-white" onclick="submitSingleRequestAction('<%= request._id %>', 'approve')" title="Approve">
                          <i class="fas fa-check"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-danger text-white ms-1" data-bs-toggle="modal" data-bs-target="#rejectModal<%= request._id %>" title="Reject">
                          <i class="fas fa-times"></i>
                        </button>
                      <% } %>
                    </td>
                  </tr>

                <!-- View Modal -->
                <div class="modal fade" id="viewRequestModal<%= request._id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog">
                    <div class="modal-content border-0 shadow">
                      <div class="modal-header bg-light border-0">
                        <h5 class="modal-title fw-bold"><i class="fas fa-info-circle me-2 text-primary"></i> Request Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body p-4">
                        <ul class="list-group list-group-flush">
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted small">Full Name</span>
                            <span class="fw-bold"><%= request.firstName %> <%= request.lastName %></span>
                          </li>
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted small">Email Address</span>
                            <span class="fw-bold"><%= request.email %></span>
                          </li>
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted small">Staff Number</span>
                            <span class="fw-bold"><%= request.staffNumber %></span>
                          </li>
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted small">Phone Number</span>
                            <span class="fw-bold"><%= request.phone || 'N/A' %></span>
                          </li>
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted small">Academic Rank</span>
                            <span class="fw-bold"><%= request.academicRank || 'N/A' %></span>
                          </li>
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted small">Office Location</span>
                            <span class="fw-bold"><%= request.officeLocation || 'N/A' %></span>
                          </li>
                          <% if (request.status === 'Rejected') { %>
                            <li class="list-group-item d-flex justify-content-between px-0">
                              <span class="text-muted small">Rejection Reason</span>
                              <span class="fw-bold text-danger"><%= request.rejectionReason %></span>
                            </li>
                          <% } %>
                        </ul>
                      </div>
                      <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Reject Modal -->
                <% if (request.status === 'Pending') { %>
                <div class="modal fade" id="rejectModal<%= request._id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog">
                    <form action="/hod/lecturer-requests/<%= request._id %>/reject" method="POST">
                      <div class="modal-content border-0 shadow">
                        <div class="modal-header bg-danger text-white border-0">
                          <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> Reject Request</h5>
                          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                          <p class="small text-muted">You are about to reject the request for <strong><%= request.firstName %> <%= request.lastName %></strong>. Please provide a reason.</p>
                          <div class="mb-3">
                            <label class="form-label small fw-bold">Rejection Reason <span class="text-danger">*</span></label>
                            <textarea name="reason" class="form-control" rows="3" required placeholder="e.g. Invalid Staff Number"></textarea>
                          </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>
                <% } %>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">
                  <div class="mb-2"><i class="fas fa-inbox fa-2x opacity-50"></i></div>
                  No requests found
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      </form>
    </div>
  </div>
</div>

<form id="singleActionForm" action="/hod/lecturer-requests/bulk-action" method="POST" class="d-none">
  <input type="hidden" name="action" id="singleActionType">
  <input type="hidden" name="requestIds[]" id="singleActionRequestId">
</form>

<!-- Bulk Reject Modal -->
<div class="modal fade" id="bulkRejectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-danger text-white border-0">
        <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> Reject Selected Requests</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <p class="small text-muted">You are about to reject the selected requests. Please provide a reason.</p>
        <div class="mb-3">
          <label class="form-label small fw-bold">Rejection Reason <span class="text-danger">*</span></label>
          <textarea id="bulkRejectReason" class="form-control" rows="3" required placeholder="e.g. Invalid Staff Number"></textarea>
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" onclick="submitBulkReject()">Confirm Rejection</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selectAll = document.getElementById('selectAllRequests');
    const checkboxes = document.querySelectorAll('.request-checkbox');
    
    if (selectAll) {
      selectAll.addEventListener('change', function() {
        checkboxes.forEach(cb => cb.checked = selectAll.checked);
      });
    }
    
    checkboxes.forEach(cb => {
      cb.addEventListener('change', function() {
        if (!this.checked) selectAll.checked = false;
        else if (document.querySelectorAll('.request-checkbox:checked').length === checkboxes.length) {
          selectAll.checked = true;
        }
      });
    });
  });

  function submitSingleRequestAction(requestId, action) {
    document.getElementById('singleActionType').value = action;
    document.getElementById('singleActionRequestId').value = requestId;
    document.getElementById('singleActionForm').submit();
  }

  function submitBulkReject() {
    const reason = document.getElementById('bulkRejectReason').value;
    if (!reason.trim()) {
      alert("Please provide a rejection reason.");
      return;
    }
    const form = document.getElementById('bulkRequestForm');
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'reason';
    input.value = reason;
    form.appendChild(input);
    
    const actionInput = document.createElement('input');
    actionInput.type = 'hidden';
    actionInput.name = 'action';
    actionInput.value = 'reject';
    form.appendChild(actionInput);
    
    form.submit();
  }
</script>
