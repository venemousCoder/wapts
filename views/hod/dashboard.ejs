<div class="row align-items-center mb-4">
  <div class="col-md-8">
    <h2 class="fw-bold mb-1 text-dark">Department Dashboard</h2>
    <p class="text-muted mb-0">Welcome back, <%= user.firstName %>.</p>
  </div>
  <div class="col-md-4 text-md-end mt-3 mt-md-0">
    <a href="/hod/analytics" class="btn btn-primary shadow-sm">
      <i class="fas fa-chart-line me-2"></i> View Analytics
    </a>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-warning border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Pending Approvals</h6>
            <h3 class="fw-bold text-dark mb-0"><%= pendingApprovals %></h3>
          </div>
          <div class="icon-circle bg-warning bg-opacity-10 text-warning">
            <i class="fas fa-exclamation-circle"></i>
          </div>
        </div>
        <div class="mt-3 text-warning small fw-medium">
          <i class="fas fa-clock me-1"></i> Requires attention
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-primary border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Active Courses</h6>
            <h3 class="fw-bold text-dark mb-0"><%= activeCourses %></h3>
          </div>
          <div class="icon-circle bg-primary bg-opacity-10 text-primary">
            <i class="fas fa-book"></i>
          </div>
        </div>
        <div class="mt-3 text-primary small fw-medium">
          <i class="fas fa-calendar me-1"></i> Current Semester
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-success border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Total Students</h6>
            <h3 class="fw-bold text-dark mb-0"><%= totalStudents %></h3>
          </div>
          <div class="icon-circle bg-success bg-opacity-10 text-success">
            <i class="fas fa-users"></i>
          </div>
        </div>
        <div class="mt-3 text-success small fw-medium">
          <i class="fas fa-arrow-up me-1"></i> Enrolled
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-secondary border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Staff Count</h6>
            <h3 class="fw-bold text-dark mb-0"><%= staffCount %></h3>
          </div>
          <div class="icon-circle bg-secondary bg-opacity-10 text-secondary">
            <i class="fas fa-user-tie"></i>
          </div>
        </div>
        <div class="mt-3 text-secondary small fw-medium">
          <i class="fas fa-building me-1"></i> Department Faculty
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-bottom-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold text-dark"><i class="fas fa-check-double me-2 text-warning"></i> Recent Result Submissions</h5>
        <a href="/hod/results/review" class="btn btn-sm btn-light text-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Course</th>
                <th>Lecturer</th>
                <th>Submitted Date</th>
                <th>Status</th>
                <th class="text-end pe-4">Action</th>
              </tr>
            </thead>
            <tbody class="border-top-0">
              <% if (recentSubmissions && recentSubmissions.length > 0) { %>
                <% recentSubmissions.forEach(sub => { 
                    const course = sub.enrollmentId.courseOfferingId.courseId;
                    const lecturerUser = sub.enrollmentId.courseOfferingId.lecturerId.userId;
                %>
                  <tr>
                    <td class="ps-4 py-3">
                      <div class="d-flex align-items-center">
                        <div class="icon-circle bg-primary bg-opacity-10 text-primary me-3" style="width: 40px; height: 40px; font-size: 1rem;">
                          <%= course.code.substring(0, 2) %>
                        </div>
                        <div>
                          <h6 class="mb-0 fw-bold text-dark"><%= course.title %></h6>
                          <div class="text-muted small"><%= course.code %></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="d-flex align-items-center">
                        <img src="https://ui-avatars.com/api/?name=<%= lecturerUser.firstName %>+<%= lecturerUser.lastName %>&background=f1f5f9&color=64748b" class="rounded-circle me-2" width="30" height="30">
                        <span><%= lecturerUser.firstName %> <%= lecturerUser.lastName %></span>
                      </div>
                    </td>
                    <td>
                      <span class="text-muted"><i class="far fa-calendar-alt me-1"></i> <%= new Date(sub.updatedAt).toLocaleDateString() %></span>
                    </td>
                    <td><span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill"><%= sub.status %></span></td>
                    <td class="text-end pe-4">
                      <a href="/hod/results/review" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">Review</a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-5">
                    <div class="empty-state p-0">
                      <i class="fas fa-check-circle text-success opacity-50 mb-3" style="font-size: 2.5rem;"></i>
                      <h6 class="fw-bold">All caught up!</h6>
                      <p class="small mb-0">No pending result submissions to review.</p>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
