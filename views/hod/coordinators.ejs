<div class="row mb-4">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <div>
      <h2 class="fw-bold mb-1">Level Coordinators</h2>
      <p class="text-muted">Manage Level Coordinator responsibilities for your lecturers.</p>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="fas fa-check-circle me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Employee ID</th>
            <th>Level Coordinator</th>
            <th>Assigned Levels</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (lecturers && lecturers.length > 0) { %>
            <% lecturers.forEach(lecturer => { %>
              <% const isCoordinator = lecturer.profile && lecturer.profile.responsibilities && lecturer.profile.responsibilities.includes('LEVEL_COORDINATOR'); %>
              <% const assignedLevels = (lecturer.profile && lecturer.profile.assignedLevels) ? lecturer.profile.assignedLevels.join(', ') : ''; %>
              <tr>
                <td class="fw-medium"><%= lecturer.firstName %> <%= lecturer.lastName %></td>
                <td><%= lecturer.email %></td>
                <td><%= lecturer.loginIdentifier %></td>
                <td>
                  <span class="badge bg-<%= isCoordinator ? 'success' : 'secondary' %> bg-opacity-10 text-<%= isCoordinator ? 'success' : 'secondary' %> px-2 py-1">
                    <%= isCoordinator ? 'Yes' : 'No' %>
                  </span>
                </td>
                <td><%= isCoordinator && assignedLevels ? assignedLevels + ' Level' : 'N/A' %></td>
                <td>
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assignModal<%= lecturer._id %>">
                    Manage Assignment
                  </button>
                </td>
              </tr>

              <!-- Manage Assignment Modal -->
              <div class="modal fade" id="assignModal<%= lecturer._id %>" tabindex="-1" aria-labelledby="assignModalLabel<%= lecturer._id %>" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content border-0 shadow">
                    <div class="modal-header border-0 pb-0">
                      <h5 class="modal-title fw-bold" id="assignModalLabel<%= lecturer._id %>">Manage Coordinator Assignment</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <p><strong>Lecturer:</strong> <%= lecturer.firstName %> <%= lecturer.lastName %></p>
                      <hr>
                      <form action="/hod/coordinators/<%= lecturer._id %>/assign" method="POST" class="mb-3">
                        <div class="mb-3">
                          <label class="form-label small fw-bold">Assigned Levels (comma separated)</label>
                          <input type="text" name="assignedLevels" class="form-control" placeholder="e.g. 100, 200" value="<%= assignedLevels %>" required>
                          <div class="form-text">Specify which levels this lecturer will manage.</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-check-circle me-1"></i> Assign as Level Coordinator</button>
                      </form>
                      <% if (isCoordinator) { %>
                        <form action="/hod/coordinators/<%= lecturer._id %>/remove" method="POST">
                          <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Are you sure you want to revoke Level Coordinator responsibilities from this lecturer?');">
                            <i class="fas fa-times-circle me-1"></i> Revoke Coordinator Role
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">No lecturers found in your department.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
