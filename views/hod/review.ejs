<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="fw-bold mb-1">Review Results</h2>
      <p class="text-muted">Review, approve, and publish course results submitted by lecturers.</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i> Action completed successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <h5 class="fw-bold text-primary mb-0 me-3"><i class="fas fa-clipboard-check me-2"></i> Department Submissions</h5>
            <span class="badge bg-secondary rounded-pill"><%= results.length %> Records</span>
          </div>
          <% const approvedResults = results.filter(r => r.status === 'Approved'); %>
          <% if (approvedResults.length > 0) { %>
            <form action="/hod/results/publish-all" method="POST" class="m-0">
              <button type="submit" class="btn btn-success shadow-sm fw-bold px-4 rounded-pill" onclick="return confirm('Are you sure you want to publish all <%= approvedResults.length %> approved results? They will become permanently visible to students.')">
                <i class="fas fa-bullhorn me-2"></i> Publish All (<%= approvedResults.length %>)
              </button>
            </form>
          <% } %>
        </div>
        <div class="card-body">
          <% if (results.length > 0) { %>
            <form action="/hod/results/bulk-action" method="POST" id="bulkActionForm">
              <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="selectAllResults">
                  <label class="form-check-label fw-bold" for="selectAllResults">Select All</label>
                </div>
                <div>
                  <button type="submit" name="action" value="approve" class="btn btn-sm btn-outline-primary px-3 rounded-pill me-2">
                    <i class="fas fa-check me-1"></i> Approve Selected
                  </button>
                  <button type="submit" name="action" value="publish" class="btn btn-sm btn-outline-success px-3 rounded-pill">
                    <i class="fas fa-bullhorn me-1"></i> Publish Selected
                  </button>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th width="40"></th>
                      <th>Course Code</th>
                      <th>Student Name</th>
                      <th>Identifier</th>
                      <th>Score</th>
                      <th>Grade</th>
                      <th>Status</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% results.forEach(result => { %>
                      <tr>
                        <td>
                          <% if (result.status === 'Submitted' || result.status === 'Approved') { %>
                            <div class="form-check">
                              <input class="form-check-input result-checkbox" type="checkbox" name="resultIds[]" value="<%= result._id %>">
                            </div>
                          <% } %>
                        </td>
                        <td class="fw-medium"><%= result.enrollmentId.courseOfferingId.courseId.code %></td>
                        <td><%= result.enrollmentId.studentId.userId.firstName %> <%= result.enrollmentId.studentId.userId.lastName %></td>
                        <td><span class="text-muted"><%= result.enrollmentId.studentId.userId.loginIdentifier %></span></td>
                        <td><%= result.finalScore %></td>
                        <td class="fw-bold text-<%= result.isPass ? 'success' : 'danger' %>"><%= result.letterGrade %></td>
                        <td>
                          <% let badgeClass = 'secondary';
                             if (result.status === 'Submitted') badgeClass = 'info';
                             if (result.status === 'Approved') badgeClass = 'primary';
                          %>
                          <span class="badge bg-<%= badgeClass %> bg-opacity-10 text-<%= badgeClass %> px-2 py-1"><%= result.status %></span>
                        </td>
                        <td>
                          <% if (result.status === 'Submitted') { %>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" onclick="submitSingleAction('<%= result._id %>', 'approve')">
                              Approve
                            </button>
                          <% } else if (result.status === 'Approved') { %>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#publishModal<%= result._id %>">
                              Publish
                            </button>
                            
                            <!-- Publish Modal -->
                            <div class="modal fade" id="publishModal<%= result._id %>" tabindex="-1" aria-hidden="true">
                              <div class="modal-dialog">
                                <div class="modal-content border-0 shadow">
                                  <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold">Publish Result</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                  </div>
                                  <div class="modal-body">
                                    <p>Are you sure you want to publish the result for <strong><%= result.enrollmentId.studentId.userId.firstName %> <%= result.enrollmentId.studentId.userId.lastName %></strong>?</p>
                                    <p class="text-success small mb-0"><i class="fas fa-info-circle me-1"></i> Once published, this result will be visible to the student and will permanently affect their CGPA calculations.</p>
                                  </div>
                                  <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                    <button type="button" class="btn btn-success px-4" onclick="submitSingleAction('<%= result._id %>', 'publish')">Confirm Publish</button>
                                  </div>
                                </div>
                              </div>
                            </div>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </form>

            <form id="singleActionForm" action="/hod/results/bulk-action" method="POST" class="d-none">
              <input type="hidden" name="action" id="singleActionType">
              <input type="hidden" name="resultIds[]" id="singleActionResultId">
            </form>

            <script>
              document.addEventListener('DOMContentLoaded', function() {
                const selectAll = document.getElementById('selectAllResults');
                const checkboxes = document.querySelectorAll('.result-checkbox');
                
                if (selectAll) {
                  selectAll.addEventListener('change', function() {
                    checkboxes.forEach(cb => cb.checked = selectAll.checked);
                  });
                }
                
                checkboxes.forEach(cb => {
                  cb.addEventListener('change', function() {
                    if (!this.checked) selectAll.checked = false;
                    else if (document.querySelectorAll('.result-checkbox:checked').length === checkboxes.length) {
                      selectAll.checked = true;
                    }
                  });
                });
              });

              function submitSingleAction(resultId, action) {
                document.getElementById('singleActionType').value = action;
                document.getElementById('singleActionResultId').value = resultId;
                const form = document.getElementById('singleActionForm');
                form.submit();
              }
            </script>
          <% } else { %>
            <div class="text-center py-5 text-muted">
              <i class="fas fa-inbox fa-3x mb-3 text-light"></i>
              <p>No pending results have been submitted by lecturers yet.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
