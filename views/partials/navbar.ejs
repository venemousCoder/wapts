<nav class="navbar navbar-expand-lg top-navbar px-4 py-3 w-100 sticky-top shadow-sm" style="z-index: 1020;">
  <div class="container-fluid p-0 d-flex align-items-center">
    
    <!-- Mobile toggle for sidebar -->
    <button class="navbar-toggler d-md-none border-0 me-2" type="button" id="sidebarToggle" aria-label="Toggle navigation">
      <i class="fas fa-bars text-primary"></i>
    </button>

    <!-- Contextual Navigation (Back Button & Breadcrumbs) -->
    <div class="d-flex align-items-center me-auto">
      <% 
        const isDashboard = typeof path !== 'undefined' && path.includes('dashboard');
        if (!isDashboard) { 
      %>
        <a href="javascript:history.back()" class="btn btn-sm btn-light text-primary fw-bold me-3 rounded-pill px-3 d-none d-sm-inline-block shadow-sm">
          <i class="fas fa-arrow-left me-1"></i> Back
        </a>
      <% } %>

      <nav aria-label="breadcrumb" class="d-none d-md-flex align-items-center mb-0">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/<%= user.role.toLowerCase() %>/dashboard" class="text-decoration-none text-primary fw-medium"><%= user.role %></a></li>
          <% if (typeof title !== 'undefined' && title !== 'Dashboard') { %>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page"><%= title %></li>
          <% } %>
        </ol>
      </nav>
      <!-- Mobile Title Fallback -->
      <div class="d-md-none fw-bold text-dark fs-5">
        <%= typeof title !== 'undefined' ? title : 'Dashboard' %>
      </div>
    </div>

    <div class="d-flex align-items-center ms-auto gap-3">
      <!-- Search Input -->
      <div class="d-none d-lg-flex align-items-center position-relative">
        <i class="fas fa-search position-absolute text-muted" style="left: 1rem;"></i>
        <input type="text" class="form-control rounded-pill bg-light border-0 ps-5 pe-4" placeholder="Search...">
      </div>

      <!-- Notifications -->
      <a href="#" class="text-secondary position-relative fs-5 text-decoration-none bg-light p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
        <i class="fas fa-bell"></i>
        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
          <span class="visually-hidden">New alerts</span>
        </span>
      </a>

      <!-- User Profile Dropdown -->
      <div class="dropdown">
        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
          <img src="https://ui-avatars.com/api/?name=<%= user.firstName %>+<%= user.lastName %>&background=0f3d81&color=fff&rounded=true&bold=true" alt="User Avatar" class="rounded-circle me-2 shadow-sm" width="40" height="40">
          <div class="d-none d-md-block text-start me-2">
            <div class="fw-bold small lh-1 text-dark"><%= user.firstName %> <%= user.lastName %></div>
            <div class="text-muted" style="font-size: 0.75rem;"><%= user.role %></div>
          </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 rounded-3" aria-labelledby="userDropdown">
          <li>
            <div class="dropdown-header d-md-none">
              <strong><%= user.firstName %> <%= user.lastName %></strong><br>
              <span class="text-muted"><%= user.role %></span>
            </div>
          </li>
          <li><a class="dropdown-item py-2" href="#"><i class="fas fa-user-circle me-2 text-muted"></i> Profile</a></li>
          <li><a class="dropdown-item py-2" href="#"><i class="fas fa-cog me-2 text-muted"></i> Settings</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item py-2 text-danger fw-medium" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
        </ul>
      </div>
    </div>
  </div>
</nav>
