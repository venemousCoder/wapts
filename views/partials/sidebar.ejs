<div class="sidebar d-flex flex-column flex-shrink-0" id="sidebar">
  <div class="sidebar-brand">
    <i class="fas fa-graduation-cap me-3 fa-lg"></i>
    <h3 class="mb-0">WAPTS</h3>
    <button class="btn btn-link text-dark d-md-none ms-auto" id="sidebarCloseBtn">
      <i class="fas fa-times"></i>
    </button>
  </div>
  <ul class="nav nav-pills flex-column mb-auto p-2">
    <% if (user.role === 'Admin') { %>
      <li class="nav-item">
        <a href="/admin/dashboard" class="nav-link <%= typeof path !== 'undefined' && path === '/admin/dashboard' ? 'active' : '' %>">
          <i class="fas fa-chart-pie"></i> <span>Dashboard</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/users" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/admin/users') ? 'active' : '' %>">
          <i class="fas fa-users"></i> <span>Users</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/departments" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/admin/departments') ? 'active' : '' %>">
          <i class="fas fa-building"></i> <span>Departments</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/calendar" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/admin/calendar') ? 'active' : '' %>">
          <i class="fas fa-calendar-alt"></i> <span>Calendar</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/grades" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/admin/grades') ? 'active' : '' %>">
          <i class="fas fa-sort-numeric-down"></i> <span>Grades</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/admin/settings" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/admin/settings') ? 'active' : '' %>">
          <i class="fas fa-cog"></i> <span>Settings</span>
        </a>
      </li>
    <% } else if (user.role === 'HOD') { %>
      <li class="nav-item">
        <a href="/hod/dashboard" class="nav-link <%= typeof path !== 'undefined' && path === '/hod/dashboard' ? 'active' : '' %>">
          <i class="fas fa-chart-pie"></i> <span>Dashboard</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/hod/coordinators" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/hod/coordinators') ? 'active' : '' %>">
          <i class="fas fa-user-tie"></i> <span>Level Coordinators</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/hod/lecturer-requests" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/hod/lecturer-requests') ? 'active' : '' %>">
          <i class="fas fa-chalkboard-teacher"></i> <span>Lecturer Requests</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/hod/courses" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/hod/courses') ? 'active' : '' %>">
          <i class="fas fa-book"></i> <span>Courses</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/hod/offerings" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/hod/offerings') ? 'active' : '' %>">
          <i class="fas fa-chalkboard"></i> <span>Course Offerings</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/hod/results/review" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/hod/results') ? 'active' : '' %>">
          <i class="fas fa-check-double"></i> <span>Review Results</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/hod/analytics" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/hod/analytics') ? 'active' : '' %>">
          <i class="fas fa-chart-line"></i> <span>Analytics</span>
        </a>
      </li>
    <% } else if (user.role === 'Lecturer') { %>
      <li class="nav-item">
        <a href="/lecturer/dashboard" class="nav-link <%= typeof path !== 'undefined' && path === '/lecturer/dashboard' ? 'active' : '' %>">
          <i class="fas fa-chart-pie"></i> <span>Dashboard</span>
        </a>
      </li>
      <% if (typeof lecturerProfile !== 'undefined' && lecturerProfile && lecturerProfile.responsibilities && lecturerProfile.responsibilities.includes('LEVEL_COORDINATOR')) { %>
      <li class="nav-item">
        <a href="/lecturer/students" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/lecturer/students') ? 'active' : '' %>">
          <i class="fas fa-user-graduate"></i> <span>Student Management</span>
        </a>
      </li>
      <% } %>
      <li class="nav-item">
        <a href="/lecturer/courses" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/lecturer/courses') ? 'active' : '' %>">
          <i class="fas fa-book-open"></i> <span>My Courses</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/lecturer/attendance" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/lecturer/attendance') ? 'active' : '' %>">
          <i class="fas fa-clipboard-list"></i> <span>Attendance</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/lecturer/assessments" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/lecturer/assessments') ? 'active' : '' %>">
          <i class="fas fa-tasks"></i> <span>Assessments</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/lecturer/results" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/lecturer/results') ? 'active' : '' %>">
          <i class="fas fa-poll"></i> <span>Results</span>
        </a>
      </li>
    <% } else if (user.role === 'Student') { %>
      <li class="nav-item">
        <a href="/student/dashboard" class="nav-link <%= typeof path !== 'undefined' && path === '/student/dashboard' ? 'active' : '' %>">
          <i class="fas fa-chart-pie"></i> <span>Dashboard</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/student/courses" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/student/courses') ? 'active' : '' %>">
          <i class="fas fa-book-reader"></i> <span>Courses</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/student/attendance" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/student/attendance') ? 'active' : '' %>">
          <i class="fas fa-clipboard-user"></i> <span>Attendance</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/student/results" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/student/results') ? 'active' : '' %>">
          <i class="fas fa-award"></i> <span>Results</span>
        </a>
      </li>
      <li class="nav-item">
        <a href="/student/transcript" class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/student/transcript') ? 'active' : '' %>">
          <i class="fas fa-file-alt"></i> <span>Transcript</span>
        </a>
      </li>
    <% } %>
  </ul>
</div>
