<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WAPTS - Login</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="row g-0 login-page">
    <!-- Left Side: Branding & Illustration -->
    <div class="col-md-6 d-none d-md-flex login-left">
      <div class="mb-auto">
        <h3 class="fw-bold"><i class="fas fa-graduation-cap me-2"></i> WAPTS</h3>
      </div>
      <div>
        <h1 class="display-5 fw-bold mb-3">Empowering Academic Excellence</h1>
        <p class="lead opacity-75">Monitor your academic journey, achieve your goals, and build a successful future.</p>
      </div>
      <div class="mt-auto">
        <p class="small opacity-50">&copy; 2026 WAPTS. All rights reserved.</p>
      </div>
    </div>
    
    <!-- Right Side: Login Form -->
    <div class="col-md-6 login-right p-4">
      <div class="login-card">
        <div class="text-center mb-4">
          <h2 class="fw-bold text-dark">Welcome Back!</h2>
          <p class="text-muted">Please login to continue</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success d-flex align-items-center" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <div><%= success %></div>
          </div>
        <% } %>

        <form action="/auth/login" method="POST" id="loginForm">
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold text-uppercase" id="identifierLabel">Identifier</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
              <input type="text" name="loginIdentifier" class="form-control border-start-0 ps-0" placeholder="Registration Number or Institution Email" required>
            </div>
          </div>

          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center">
              <label class="form-label text-muted small fw-bold text-uppercase mb-0">Password</label>
              <a href="/auth/reset-password" class="small text-decoration-none text-primary">Change Password</a>
            </div>
            <div class="input-group mt-2">
              <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
              <input type="password" name="password" class="form-control border-start-0 ps-0" placeholder="Enter your password" required>
            </div>
          </div>

          <div class="mb-4 form-check">
            <input type="checkbox" class="form-check-input" id="rememberMe">
            <label class="form-check-label text-muted small" for="rememberMe">Remember me</label>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Sign In</button>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
