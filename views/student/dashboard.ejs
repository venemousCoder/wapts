<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Student Dashboard</h2>
    <p class="text-muted mb-0">Academic Progress Snapshot</p>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="card card-hover h-100 border-0 shadow-sm border-start border-primary border-4">
      <div class="card-body">
        <h6 class="text-muted text-uppercase fw-bold mb-3">Current CGPA</h6>
        <div class="d-flex align-items-center">
          <div class="fs-2 fw-bold text-dark me-3"><%= snapshot && snapshot.currentCGPA ? snapshot.currentCGPA.toFixed(2) : '0.00' %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-hover h-100 border-0 shadow-sm border-start border-success border-4">
      <div class="card-body">
        <h6 class="text-muted text-uppercase fw-bold mb-3">Credits Earned</h6>
        <div class="d-flex align-items-center">
          <div class="fs-2 fw-bold text-dark me-3"><%= snapshot ? snapshot.creditsEarned : 0 %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-hover h-100 border-0 shadow-sm border-start border-info border-4">
      <div class="card-body">
        <h6 class="text-muted text-uppercase fw-bold mb-3">Classification</h6>
        <div class="d-flex align-items-center">
          <div class="fs-4 fw-bold text-dark me-3"><%= snapshot ? snapshot.currentClassification : 'N/A' %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <% 
      let riskBorder = 'border-success';
      let riskText = 'text-success';
      if (snapshot && snapshot.riskLevel === 'High') {
        riskBorder = 'border-danger';
        riskText = 'text-danger';
      } else if (snapshot && snapshot.riskLevel === 'Medium') {
        riskBorder = 'border-warning';
        riskText = 'text-warning';
      }
    %>
    <div class="card card-hover h-100 border-0 shadow-sm border-start <%= riskBorder %> border-4">
      <div class="card-body">
        <h6 class="text-muted text-uppercase fw-bold mb-3">Academic Risk</h6>
        <div class="d-flex align-items-center">
          <div class="fs-4 fw-bold <%= riskText %> me-3">
            <i class="fas fa-exclamation-circle me-1"></i> <%= snapshot ? snapshot.riskLevel : 'Low' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm border-start border-primary border-4">
      <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <h5 class="fw-bold text-dark mb-1">Academic Goal Tracker</h5>
          <p class="text-muted mb-0 small">
            <% if (goalData && goalData.goal) { %>
              Your target CGPA is <strong><%= goalData.goal.targetCGPA.toFixed(2) %></strong>. Status: <strong class="<%= goalData.feasibility.status === 'On Track' || goalData.feasibility.status === 'Achieved' ? 'text-success' : (goalData.feasibility.status === 'At Risk' ? 'text-warning' : 'text-danger') %>"><%= goalData.feasibility.status %></strong>
            <% } else { %>
              You haven't set an academic goal yet.
            <% } %>
          </p>
        </div>
        <div class="mt-2 mt-md-0">
          <a href="/student/goal-tracker" class="btn btn-outline-primary rounded-pill px-4">
            View Goal Tracker <i class="fas fa-arrow-right ms-2"></i>
          </a>
        </div>
      </div>
      <% if (goalData && goalData.goal) { %>
        <% 
          const current = snapshot.currentCGPA || 0;
          const target = goalData.goal.targetCGPA;
          const pct = Math.min(100, Math.max(0, (current / target) * 100));
        %>
        <div class="card-footer bg-white border-0 pt-0 pb-3">
          <div class="d-flex justify-content-between small text-muted mb-1">
            <span>Current: <strong><%= current.toFixed(2) %></strong></span>
            <span>Target: <strong><%= target.toFixed(2) %></strong></span>
          </div>
          <div class="progress" style="height: 8px;">
            <div class="progress-bar <%= pct >= 100 ? 'bg-success' : 'bg-primary' %>" role="progressbar" style="width: <%= pct %>%"></div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
    <h5 class="fw-bold">CGPA Trend</h5>
  </div>
  <div class="card-body">
    <div style="height: 300px; margin-top: 10px;">
      <canvas id="cgpaChart"></canvas>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('cgpaChart').getContext('2d');
    const labels = <%- chartLabels %>;
    const gpaData = <%- chartData %>;

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels.length > 0 ? labels : ['No Data'],
        datasets: [{
          label: 'Semester GPA',
          data: gpaData.length > 0 ? gpaData : [0],
          borderColor: '#2563eb',
          tension: 0.4,
          fill: true,
          backgroundColor: 'rgba(37, 99, 235, 0.1)'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            beginAtZero: false,
            min: 0,
            max: 5.0
          }
        }
      }
    });
  });
</script>
