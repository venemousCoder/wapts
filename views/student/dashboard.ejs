<div class="row align-items-center mb-4">
  <div class="col-md-8">
    <h2 class="fw-bold mb-1 text-dark">Student Dashboard</h2>
    <p class="text-muted mb-0">Welcome back, <%= user.firstName %>.</p>
  </div>
  <div class="col-md-4 text-md-end mt-3 mt-md-0">
    <a href="/student/courses" class="btn btn-primary shadow-sm">
      <i class="fas fa-book-reader me-2"></i> My Courses
    </a>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-primary border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Current CGPA</h6>
            <h3 class="fw-bold text-dark mb-0"><%= snapshot && snapshot.currentCGPA ? snapshot.currentCGPA.toFixed(2) : '0.00' %></h3>
          </div>
          <div class="icon-circle bg-primary bg-opacity-10 text-primary">
            <i class="fas fa-chart-line"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-success border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Credits Earned</h6>
            <h3 class="fw-bold text-dark mb-0"><%= snapshot ? snapshot.creditsEarned : 0 %></h3>
          </div>
          <div class="icon-circle bg-success bg-opacity-10 text-success">
            <i class="fas fa-certificate"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card stat-card h-100 border-0 shadow-sm border-start border-info border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Classification</h6>
            <h3 class="fw-bold text-dark mb-0 fs-5 mt-1"><%= snapshot ? snapshot.currentClassification : 'N/A' %></h3>
          </div>
          <div class="icon-circle bg-info bg-opacity-10 text-info">
            <i class="fas fa-award"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <% 
      let riskBorder = 'border-success';
      let riskText = 'text-success';
      if (snapshot && snapshot.riskLevel === 'High') {
        riskBorder = 'border-danger';
        riskText = 'text-danger';
      } else if (snapshot && snapshot.riskLevel === 'Medium') {
        riskBorder = 'border-warning';
        riskText = 'text-warning';
      }
    %>
    <div class="card stat-card h-100 border-0 shadow-sm border-start <%= riskBorder %> border-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Academic Risk</h6>
            <h3 class="fw-bold <%= riskText %> mb-0 fs-5 mt-1">
              <%= snapshot ? snapshot.riskLevel : 'Low' %>
            </h3>
          </div>
          <div class="icon-circle bg-opacity-10 <%= riskText.replace('text', 'bg') %> <%= riskText %>">
            <i class="fas fa-exclamation-circle"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Goal Tracker -->
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100 border-start border-primary border-4">
      <div class="card-body d-flex flex-column justify-content-center py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold text-dark mb-0"><i class="fas fa-bullseye me-2 text-primary"></i> Goal Tracker</h5>
          <a href="/student/goal-tracker" class="btn btn-sm btn-light text-primary rounded-pill px-3">
            Manage <i class="fas fa-arrow-right ms-1"></i>
          </a>
        </div>
        
        <% if (goalData && goalData.goal) { %>
          <div class="bg-light rounded-3 p-3 mb-3">
            <p class="text-muted mb-0 small">
              Target CGPA: <strong class="text-dark"><%= goalData.goal.targetCGPA.toFixed(2) %></strong> &bull; 
              Status: <strong class="<%= goalData.feasibility.status === 'On Track' || goalData.feasibility.status === 'Achieved' ? 'text-success' : (goalData.feasibility.status === 'At Risk' ? 'text-warning' : 'text-danger') %>"><%= goalData.feasibility.status %></strong>
            </p>
          </div>
          
          <% 
            const current = snapshot.currentCGPA || 0;
            const target = goalData.goal.targetCGPA;
            const pct = Math.min(100, Math.max(0, (current / target) * 100));
          %>
          <div class="d-flex justify-content-between small text-muted mb-2 fw-medium">
            <span>Current: <%= current.toFixed(2) %></span>
            <span>Target: <%= target.toFixed(2) %></span>
          </div>
          <div class="progress" style="height: 10px; border-radius: 10px;">
            <div class="progress-bar <%= pct >= 100 ? 'bg-success' : 'bg-primary' %>" role="progressbar" style="width: <%= pct %>%"></div>
          </div>
        <% } else { %>
          <div class="text-center py-4">
            <div class="icon-circle bg-light text-muted mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
              <i class="fas fa-compass"></i>
            </div>
            <h6 class="fw-bold text-dark">No Goal Set</h6>
            <p class="small text-muted mb-0">Set an academic goal to track your progress.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Analytics Chart -->
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
        <h5 class="fw-bold text-dark mb-0"><i class="fas fa-chart-area me-2 text-primary"></i> CGPA Trend</h5>
      </div>
      <div class="card-body p-4 pt-0">
        <div style="position: relative; height: 250px; width: 100%;">
          <canvas id="cgpaChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('cgpaChart');
    if (ctx && typeof Chart !== 'undefined') {
      const labels = <%- chartLabels %>;
      const gpaData = <%- chartData %>;

      new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels.length > 0 ? labels : ['No Data'],
          datasets: [{
            label: 'Semester GPA',
            data: gpaData.length > 0 ? gpaData : [0],
            borderColor: '#0f3d81',
            backgroundColor: 'rgba(15, 61, 129, 0.1)',
            borderWidth: 3,
            tension: 0.4,
            fill: true,
            pointBackgroundColor: '#ffffff',
            pointBorderColor: '#0f3d81',
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            y: {
              beginAtZero: false,
              min: 0,
              max: 5.0,
              grid: {
                color: 'rgba(0, 0, 0, 0.05)',
                drawBorder: false
              }
            },
            x: {
              grid: {
                display: false,
                drawBorder: false
              }
            }
          }
        }
      });
    }
  });
</script>
