<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Academic Transcript</h2>
    <p class="text-muted mb-0">Comprehensive Academic Record</p>
  </div>
  <div>
    <button class="btn btn-primary"><i class="fas fa-download me-2"></i> Download PDF</button>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4 bg-primary text-white">
  <div class="card-body d-flex justify-content-between align-items-center p-4">
    <div>
      <h3 class="fw-bold mb-1"><%= data.student.userId.firstName %> <%= data.student.userId.lastName %></h3>
      <p class="mb-1 opacity-75">Reg No: <%= data.student.userId.loginIdentifier %></p>
      <p class="mb-0 opacity-75">Department: <%= data.student.departmentId.name %></p>
    </div>
    <div class="text-end">
      <div class="small text-uppercase opacity-75 fw-bold mb-1">Current CGPA</div>
      <div class="display-4 fw-bold mb-1"><%= data.cgpa ? data.cgpa.toFixed(2) : '0.00' %></div>
      <div class="small opacity-75">Credits Earned: <%= data.creditsEarned %></div>
    </div>
  </div>
</div>

<% if (data.academicRecord && data.academicRecord.length > 0) { %>
  <% data.academicRecord.forEach(sessionGroup => { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom pt-4 pb-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-primary mb-0"><%= sessionGroup.sessionName %> - <%= sessionGroup.semesterName %></h5>
        <div class="badge bg-light text-dark border fs-6 px-3 py-2">GPA: <strong><%= sessionGroup.gpa %></strong></div>
      </div>
      
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="text-muted fw-bold ps-4">Course Code</th>
                <th class="text-muted fw-bold">Course Title</th>
                <th class="text-muted fw-bold text-center">Credits</th>
                <th class="text-muted fw-bold text-center">Grade</th>
                <th class="text-muted fw-bold text-end pe-4">Grade Point</th>
              </tr>
            </thead>
            <tbody>
              <% sessionGroup.results.forEach(result => { %>
                <tr>
                  <td class="ps-4 fw-semibold"><%= result.enrollmentId.courseOfferingId.courseId.code %></td>
                  <td><%= result.enrollmentId.courseOfferingId.courseId.title %></td>
                  <td class="text-center"><%= result.enrollmentId.courseOfferingId.courseId.creditUnits %></td>
                  <td class="text-center">
                    <span class="badge <%= result.isPass ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %> border-0 px-2 py-1 fs-6">
                      <%= result.letterGrade %>
                    </span>
                  </td>
                  <td class="text-end pe-4 fw-bold"><%= result.gradePoint %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }) %>
<% } else { %>
  <div class="card border-0 shadow-sm text-center p-5">
    <div class="card-body py-5">
      <i class="fas fa-file-alt text-muted mb-3" style="font-size: 4rem; opacity: 0.2;"></i>
      <h4 class="fw-bold text-dark">No Records Found</h4>
      <p class="text-muted mb-0">You have no academic records yet or your results have not been published.</p>
    </div>
  </div>
<% } %>
