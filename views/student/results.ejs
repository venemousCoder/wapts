<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <div>
        <h2 class="fw-bold mb-1">Academic Results</h2>
        <p class="text-muted">View your published grades for completed semesters.</p>
      </div>
      <div>
        <form action="/student/results" method="GET" class="d-flex align-items-center">
          <label for="semesterId" class="me-2 fw-medium text-muted">Semester:</label>
          <select name="semesterId" id="semesterId" class="form-select form-select-sm border-0 shadow-sm bg-white rounded-pill px-3" onchange="this.form.submit()">
            <option value="">All Semesters</option>
            <% semesters.forEach(sem => { %>
              <option value="<%= sem._id %>" <%= selectedSemesterId === sem._id.toString() ? 'selected' : '' %>>
                <%= sem.sessionId.name %> - <%= sem.name %>
              </option>
            <% }) %>
          </select>
        </form>
      </div>
    </div>
  </div>

  <% if (Object.keys(resultsBySemester).length > 0) { %>
    <div class="row g-4">
      <% Object.values(resultsBySemester).forEach(data => { %>
        <% const gpa = data.totalCredits > 0 ? (data.earnedPoints / data.totalCredits).toFixed(2) : '0.00'; %>
        <div class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
              <div>
                <h5 class="fw-bold mb-0 text-primary"><i class="fas fa-calendar-alt me-2"></i><%= data.semester.sessionId.name %> - <%= data.semester.name %></h5>
              </div>
              <div>
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fs-6">GPA: <%= gpa %></span>
              </div>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Course Code</th>
                      <th>Course Title</th>
                      <th>Credits</th>
                      <th>Score</th>
                      <th>Grade</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% data.results.forEach(result => { %>
                      <tr>
                        <td class="fw-medium"><%= result.course.code %></td>
                        <td><%= result.course.title %></td>
                        <td><%= result.course.creditUnits %></td>
                        <td><%= result.finalScore !== undefined ? result.finalScore : '-' %></td>
                        <td class="fw-bold text-<%= result.isPass ? 'success' : 'danger' %>"><%= result.letterGrade || '-' %></td>
                        <td>
                          <span class="badge bg-<%= result.isPass ? 'success' : 'danger' %> bg-opacity-10 text-<%= result.isPass ? 'success' : 'danger' %> px-2 py-1">
                            <%= result.isPass ? 'Pass' : 'Fail' %>
                          </span>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="row">
      <div class="col-12">
        <div class="card border-0 shadow-sm text-center py-5">
          <div class="card-body">
            <i class="fas fa-file-contract fa-4x text-light mb-3"></i>
            <h4 class="text-muted">No Published Records Found</h4>
            <p class="text-muted mb-0">Your results for the selected period have not been published yet.</p>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>
